<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Security+ • Chapter 5 PBQ (PKI & Cryptography)</title>
<style>
  :root{
    --bg:#0b1220; --panel:#0f172a; --muted:#93a4b8; --text:#e6edf3; --accent:#60a5fa;
    --ok:#22c55e; --bad:#ef4444; --border:#1e293b;
  }
  *{box-sizing:border-box}
  body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Arial,sans-serif;background:var(--bg);color:var(--text);} 
  header{position:sticky;top:0;background:rgba(15,23,42,.7);backdrop-filter:blur(10px);border-bottom:1px solid var(--border);padding:14px 16px;z-index:2}
  header h1{margin:0;font-size:18px}
  header p{margin:4px 0 0;color:var(--muted);font-size:13px}
  main{max-width:950px;margin:18px auto;padding:0 16px 120px}
  .panel{background:var(--panel);border:1px solid var(--border);border-radius:14px;padding:16px;margin-bottom:14px}
  .row{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
  button{appearance:none;border:1px solid var(--border);background:#0b1220;color:var(--text);padding:10px 14px;border-radius:10px;cursor:pointer}
  button.primary{background:linear-gradient(180deg,#3b82f6,#2563eb);border:none;color:white;font-weight:600}
  .controls{position:sticky;bottom:0;background:rgba(15,23,42,.95);backdrop-filter:blur(10px);border-top:1px solid var(--border);padding:12px 16px;display:flex;gap:10px;justify-content:space-between;align-items:center}
  .score{font-weight:700}
  .q{display:grid;gap:6px}
  .q h3{margin:0 0 2px;font-size:16px}
  .meta{color:var(--muted);font-size:12px}
  select{width:100%;padding:9px 12px;border-radius:10px;border:1px solid var(--border);background:#0b1220;color:var(--text)}
  .fb{display:none;font-size:13px;margin-top:4px}
  .fb.ok{color:var(--ok)} .fb.bad{color:var(--bad)}
  .exp{display:none;color:var(--muted);font-size:12px}
  .grid{display:grid;grid-template-columns:1fr;gap:12px}
  .print-note{font-size:12px;color:var(--muted)}
  .diagram{background:#0a101a;border:1px solid var(--border);border-radius:12px;padding:8px}
  .keywrap{margin-top:8px}
  .keywrap pre{white-space:pre-wrap;background:#0b1220;border:1px solid var(--border);padding:10px;border-radius:10px;color:#cbd5e1;font-size:12px}
  a.link{color:#93c5fd}
  @media (min-width:800px){ .grid{grid-template-columns:1fr 1fr} }
  @media print{
    header,.controls,.print-note{display:none}
    body{background:white;color:black}
    .panel{border:1px solid #ccc;background:white}
    select{border:1px solid #888;color:black}
  }
</style>
</head>
<body>
<header>
  <h1>CompTIA Security+ — Chapter 5 PBQ (PKI & Cryptography)</h1>
  <p>Interactive dropdowns • 15 questions • Exam‑style • <span class="print-note">Use your browser’s Print to save as PDF.</span></p>
</header>

<main>
  <section class="panel">
    <div class="row">
      <button id="checkAll" class="primary">Check All</button>
      <button id="reset">Reset</button>
      <button id="shuffle">Shuffle</button>
      <button id="toggleExp">Show Explanations</button>
      <a class="link" id="printable" href="#" onclick="window.print();return false;">Printable</a>
    </div>
  </section>

  <section id="questions" class="grid">
    <!-- Questions will be injected here -->
  </section>

  <section class="panel">
    <div class="row" style="justify-content:space-between">
      <div class="score" id="score">Score: — / 15</div>
      <button id="keyBtn">Show answer key</button>
    </div>
    <div class="keywrap" id="answerKey" style="display:none">
      <pre id="keyText"></pre>
    </div>
  </section>

  <section class="panel">
    <h3 style="margin-top:0">Diagram Reference (for Q11)</h3>
    <div class="diagram">
      <svg viewBox="0 0 760 180" width="100%" height="180" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <marker id="arrow" markerWidth="10" markerHeight="10" refX="6" refY="3" orient="auto" markerUnits="strokeWidth">
            <path d="M0,0 L0,6 L6,3 z" fill="#60a5fa" />
          </marker>
        </defs>
        <rect x="10" y="20" width="160" height="70" rx="10" fill="#0d1720" stroke="#1e293b"/>
        <text x="90" y="60" fill="#e6edf3" text-anchor="middle" font-size="14">Client</text>

        <rect x="230" y="20" width="160" height="70" rx="10" fill="#0d1720" stroke="#1e293b"/>
        <text x="310" y="60" fill="#e6edf3" text-anchor="middle" font-size="14">Reverse Proxy</text>

        <rect x="450" y="20" width="160" height="70" rx="10" fill="#0d1720" stroke="#1e293b"/>
        <text x="530" y="60" fill="#e6edf3" text-anchor="middle" font-size="14">App Server</text>

        <circle cx="190" cy="140" r="20" fill="#1b0f14" stroke="#ef4444"/>
        <text x="190" y="145" fill="#ef4444" text-anchor="middle" font-size="12">Attacker</text>

        <line x1="90" y1="90" x2="310" y2="90" stroke="#60a5fa" stroke-width="3" marker-end="url(#arrow)"/>
        <line x1="310" y1="90" x2="530" y2="90" stroke="#60a5fa" stroke-width="3" marker-end="url(#arrow)"/>
        <line x1="190" y1="120" x2="190" y2="90" stroke="#ef4444" stroke-width="2"/>
      </svg>
    </div>
    <p class="meta">Client ↔ Reverse Proxy ↔ App Server; attacker attempts interception near the client.</p>
  </section>
</main>

<div class="controls">
  <div class="row">
    <button id="checkAll2" class="primary">Check All</button>
    <button id="reset2">Reset</button>
    <button id="shuffle2">Shuffle</button>
    <button id="toggleExp2">Show Explanations</button>
  </div>
  <div class="score" id="score2">Score: — / 15</div>
</div>

<script>
const QUESTIONS = [
  { id:"q1", t:"Which asymmetric algorithm is most commonly used for digital signatures on certificates?", meta:"PKI fundamentals",
    options:["AES","RSA","SHA-256","Blowfish"], correct:"RSA",
    exp:"RSA is asymmetric and used for signatures & key exchange. AES/Blowfish are symmetric; SHA-256 is a hash."
  },
  { id:"q2", t:"In an enterprise PKI, which entity signs end-entity (leaf) certificates?", meta:"PKI hierarchy",
    options:["Root CA","Intermediate CA","Registration Authority (RA)","CRL"], correct:"Intermediate CA",
    exp:"Intermediates issue/sign leaf certs; roots sign intermediates and are kept offline."
  },
  { id:"q3", t:"Which option best provides Perfect Forward Secrecy (PFS) in TLS?", meta:"TLS cipher suites",
    options:["TLS with RSA key exchange","TLS with ECDHE","TLS with static DH","TLS with MD5"], correct:"TLS with ECDHE",
    exp:"PFS requires ephemeral key exchange (DHE/ECDHE); RSA key exchange & static DH lack PFS; MD5 is obsolete."
  },
  { id:"q4", t:"Which statement about certificate revocation is most accurate?", meta:"CRL vs OCSP",
    options:["CRL provides real-time; OCSP is periodic","OCSP provides near real-time; CRL is periodic","Neither indicates revocation","Revocation only after expiry"], correct:"OCSP provides near real-time; CRL is periodic",
    exp:"OCSP responders return current status; CRLs are published lists refreshed periodically."
  },
  { id:"q5", t:"A developer generated a CSR. Which item is typically included?", meta:"CSR contents",
    options:["Applicant’s private key","Applicant’s public key and subject details","Root CA private key","CRL distribution points"], correct:"Applicant’s public key and subject details",
    exp:"The CSR contains the subject’s public key and identifiers; private keys never go in the CSR."
  },
  { id:"q6", t:"Which format is most appropriate to import a certificate with its private key on Windows?", meta:"Certificate formats",
    options:["PEM (.pem/.crt)","DER (.der)","PFX / PKCS#12 (.pfx/.p12)","PKCS#7 (.p7b)"], correct:"PFX / PKCS#12 (.pfx/.p12)",
    exp:"PFX/PKCS#12 can bundle certs + private key (password-protected)."
  },
  { id:"q7", t:"Which email security standard provides end-to-end encryption and signing using X.509 certs?", meta:"Email security",
    options:["DKIM","SPF","S/MIME","PGP/MIME (Web of Trust)"], correct:"S/MIME",
    exp:"S/MIME uses X.509 and centralized trust; PGP uses a web of trust; DKIM/SPF are domain auth mechanisms."
  },
  { id:"q8", t:"Your organization mandates key escrow. Which statement fits?", meta:"Key management",
    options:["A third party retains copies of private keys for recovery/legal access","Only public keys are archived","Same as key stretching","Requires TLS 1.3"], correct:"A third party retains copies of private keys for recovery/legal access",
    exp:"Key escrow involves retaining private keys under split or controlled custody for recovery/compliance."
  },
  { id:"q9", t:"Which combo best describes an IPsec site-to-site VPN with confidentiality and integrity?", meta:"IPsec modes/protocols",
    options:["AH transport + MD5","ESP tunnel + AES-GCM","ESP transport + NULL encryption","AH tunnel + SHA-1 only"], correct:"ESP tunnel + AES-GCM",
    exp:"ESP provides confidentiality and integrity; tunnel mode for site-to-site; AES-GCM gives AEAD."
  },
  { id:"q10", t:"Which statement about ECC is true?", meta:"Asymmetric algorithms",
    options:["ECC gives equivalent security with shorter keys than RSA","ECC is a symmetric block cipher","ECC can't be used for signatures","ECC is only for hashing"], correct:"ECC gives equivalent security with shorter keys than RSA",
    exp:"ECC (ECDSA/ECDH) offers comparable security with smaller keys; good for performance and mobile devices."
  },
  { id:"q11", t:"Diagram: Best control to defeat a MitM between client and reverse proxy?", meta:"TLS hardening · scenario",
    options:["Disable TLS; use HTTP","TLS 1.3 with certificate pinning on client","Use MD5 to hash traffic","Share one symmetric key with all clients"], correct:"TLS 1.3 with certificate pinning on client",
    exp:"Pinning ensures the client trusts only the expected server cert, reducing MitM risk."
  },
  { id:"q12", t:"Which control best protects at-rest database records with keys in hardware?", meta:"HSM / key protection",
    options:["Full-disk encryption; keys in app code","Transparent data encryption; keys in HSM","RAID 1 mirroring","CRC checksums"], correct:"Transparent data encryption; keys in HSM",
    exp:"TDE encrypts DB data; HSM protects keys in tamper-resistant hardware."
  },
  { id:"q13", t:"Which is the best example of key stretching for password storage?", meta:"Password hashing",
    options:["Base64-encoding","PBKDF2/bcrypt/scrypt/Argon2 with salt","MD5 with no salt","ZIP password with AES-128"], correct:"PBKDF2/bcrypt/scrypt/Argon2 with salt",
    exp:"Modern KDFs with salt deliberately slow cracking attempts."
  },
  { id:"q14", t:"A cert for api.example.com must also cover auth.example.com and files.example.com. Best choice?", meta:"SAN vs wildcard",
    options:["Single-name certificate","Wildcard certificate for *.example.com","Self-signed on each host","Code signing certificate"], correct:"Wildcard certificate for *.example.com",
    exp:"Wildcard or SAN certs cover multiple subdomains; wildcard is the single-cert approach."
  },
  { id:"q15", t:"During a TLS handshake, what authenticates the server to the client?", meta:"TLS handshake",
    options:["Server’s X.509 certificate and proof of private key","Client’s password","OCSP stapling alone","DNSSEC"], correct:"Server’s X.509 certificate and proof of private key",
    exp:"The server presents its cert and demonstrates possession of the private key via the handshake."
  }
];

function el(tag,props={},children=[]) {
  const e = document.createElement(tag);
  Object.assign(e, props);
  (Array.isArray(children)?children:[children]).filter(Boolean).forEach(c=>e.appendChild(typeof c==='string'?document.createTextNode(c):c));
  return e;
}

function renderQuestion(q) {
  const card = el('section',{className:'panel q', dataset:{id:q.id}});
  const title = el('h3',{}, q.t);
  const meta = el('div',{className:'meta'}, q.meta);
  const sel = el('select');
  sel.appendChild(el('option',{value:""}, "— Select —"));
  q.options.forEach(o => sel.appendChild(el('option',{value:o}, o)));
  const fb = el('div',{className:'fb'});
  const exp = el('div',{className:'exp'}, q.exp);
  card.append(title, meta, sel, fb, exp);
  return card;
}

let order = [...QUESTIONS];
const container = document.getElementById('questions');
function draw(){
  container.innerHTML = "";
  order.forEach(q => container.appendChild(renderQuestion(q)));
}

draw();

function checkAll() {
  let correct = 0;
  const cards = Array.from(document.querySelectorAll('.q'));
  cards.forEach(card => {
    const id = card.dataset.id;
    const q = QUESTIONS.find(x=>x.id===id);
    const sel = card.querySelector('select');
    const fb = card.querySelector('.fb');
    const exp = card.querySelector('.exp');
    const val = sel.value;
    if (!val) {
      fb.textContent = "Select an answer.";
      fb.className = "fb bad";
      fb.style.display = "block";
      exp.style.display = "none";
      return;
    }
    if (val === q.correct) {
      correct++;
      fb.textContent = "Correct ✓";
      fb.className = "fb ok";
      exp.style.display = "none";
    } else {
      fb.textContent = "Incorrect ✗";
      fb.className = "fb bad";
      exp.style.display = "block";
    }
    fb.style.display = "block";
  });
  document.getElementById('score').textContent = `Score: ${correct} / ${QUESTIONS.length}`;
  document.getElementById('score2').textContent = `Score: ${correct} / ${QUESTIONS.length}`;
}

function resetAll() {
  document.querySelectorAll('select').forEach(s => s.selectedIndex = 0);
  document.querySelectorAll('.fb').forEach(f => { f.style.display='none'; f.textContent=""; f.className='fb'; });
  document.querySelectorAll('.exp').forEach(e => e.style.display='none');
  document.getElementById('score').textContent = "Score: — / 15";
  document.getElementById('score2').textContent = "Score: — / 15";
  window.scrollTo({top:0,behavior:'smooth'});
}

function shuffle() {
  for (let i = order.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [order[i], order[j]] = [order[j], order[i]];
  }
  draw();
}

function toggleExplanations() {
  const blocks = Array.from(document.querySelectorAll('.exp'));
  const anyHidden = blocks.some(b => b.style.display !== 'block');
  blocks.forEach(b => b.style.display = anyHidden ? 'block' : 'none');
}

function showKey() {
  const key = QUESTIONS.map((q,i)=> `${i+1}. ${q.correct}`).join("\n");
  document.getElementById('keyText').textContent = key;
  const elKey = document.getElementById('answerKey');
  elKey.style.display = (elKey.style.display === 'none' || !elKey.style.display) ? 'block' : 'none';
}

document.getElementById('checkAll').addEventListener('click', checkAll);
DocumentTimeline

document.getElementById('checkAll2').addEventListener('click', checkAll);
document.getElementById('reset').addEventListener('click', resetAll);
document.getElementById('reset2').addEventListener('click', resetAll);
document.getElementById('shuffle').addEventListener('click', shuffle);
document.getElementById('shuffle2').addEventListener('click', shuffle);
document.getElementById('toggleExp').addEventListener('click', toggleExplanations);
document.getElementById('toggleExp2').addEventListener('click', toggleExplanations);
document.getElementById('keyBtn').addEventListener('click', showKey);
</script>
</body>
</html>
